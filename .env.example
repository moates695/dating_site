# Copy to .env and fill in. .env is gitignored; never commit real values.

# local | prod
# In local mode a person's bundle is served straight from PAGES_DIR/<token>
# so edits appear on refresh. In prod the published snapshot is served.
APP_ENV=local

# Local development uses the Postgres container from docker-compose.dev.yml.
# Production data lives on the droplet and is never touched by local testing.
DATABASE_URL=postgresql://events:events@localhost:5433/event_picker_dev

# For a prod env file (.env.prod), point at the droplet's database through an
# SSH tunnel instead, used by publish.py and list_people.py from your machine:
#   ssh -f -N -L 25432:localhost:5432 do
#   DATABASE_URL=postgresql://events:REAL_PASSWORD@localhost:25432/event_picker

# Where page bundles live. Mounted as a volume in production.
PAGES_DIR=./pages

# Used to print full URLs from the scripts.
SITE_BASE_URL=http://localhost:8000

# Leave blank locally to log notifications to the console instead of sending
# them. Get the chat id by messaging the bot then calling getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Only used by scripts/publish.py against a prod env file. DEPLOY_SSH_HOST is
# an ssh config alias; DEPLOY_PAGES_DIR is the volume mounted into the container.
DEPLOY_SSH_HOST=do
DEPLOY_PAGES_DIR=/opt/event_picker/pages
