# Secrets. This repo is public. Never commit real credentials.
.env
.env.*
!.env.example

# Personal page bundles. Everything under pages/ is personal content except the
# shared starter, which is structural, and the demo page, which is written to be
# public and is the link this repo is shown with.
pages/*
!pages/_base/
!pages/tryevents/

# Database dumps: these would contain real names, tokens and responses.
*.dump
*.sql.gz
*.backup
db_schema/dumps/

# Scratch notes. These are where page content gets drafted, so they hold the
# same names and places the bundles do.
temp.md
scratch.md
notes.md

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
